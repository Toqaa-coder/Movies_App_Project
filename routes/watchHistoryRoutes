const express = require('express');
const router = express.Router();
const { verifyToken } = require('../middleware/authMiddleware');
const {
  createWatchHistory,
  getAllWatchHistory,
  searchWatchHistory,
  updateWatchHistory,
  deleteWatchHistory
} = require('../controller/watchHistoryController');

router.post('/', verifyToken, createWatchHistory);
router.get('/', verifyToken, getAllWatchHistory);
router.get('/search', verifyToken, searchWatchHistory);
router.put('/:id', verifyToken, updateWatchHistory);
router.delete('/:id', verifyToken, deleteWatchHistory);

module.exports = router;